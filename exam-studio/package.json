{
  "name": "exam-studio",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "android:apk:local": "bash ./scripts/android-build-release-local.sh apk",
    "android:aab:local": "bash ./scripts/android-build-release-local.sh aab",
    "android:gradle:apk": "cd android && ./gradlew assembleRelease",
    "android:gradle:aab": "cd android && ./gradlew bundleRelease",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:env && npm run typecheck",
    "check:env": "node ./scripts/validate-env.mjs development",
    "check:prod-env": "node ./scripts/validate-env.mjs production",
    "ci": "npm run check"
  },
  "dependencies": {
    "@better-auth/expo": "1.5.5",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/react-query": "^5.94.5",
    "better-auth": "^1.5.5",
    "expo": "~55.0.8",
    "expo-constants": "~55.0.9",
    "expo-device": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.8",
    "expo-image": "~55.0.6",
    "expo-image-picker": "^55.0.13",
    "expo-linking": "~55.0.8",
    "expo-network": "^55.0.9",
    "expo-notifications": "^55.0.13",
    "expo-print": "~55.0.9",
    "expo-router": "~55.0.7",
    "expo-screen-capture": "~55.0.9",
    "expo-secure-store": "^55.0.9",
    "expo-sharing": "~55.0.14",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "expo-web-browser": "~55.0.10",
    "i18next": "^25.10.5",
    "katex": "^0.16.40",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.6.2",
    "react-native": "0.83.2",
    "react-native-blob-util": "^0.24.7",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pdf": "^7.0.4",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.1"
  },
  "private": true
}
