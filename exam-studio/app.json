{
  "expo": {
    "name": "MM Exam Studio",
    "slug": "exam-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "examstudio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.waihsu1999.examstudio"
    },
    "android": {
      "blockedPermissions": ["android.permission.WRITE_EXTERNAL_STORAGE"],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.waihsu1999.examstudio",
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFF",
          "image": "./assets/images/logo-glow.png",
          "imageWidth": 138,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/logo-glow.png",
            "imageWidth": 138
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a6eedfa6-45ca-41cb-b73c-aab81bb8ad6f"
      }
    },
    "owner": "waihsu1999"
  }
}
