{
	"name": "server",
	"version": "0.0.1",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "bun --watch run src/index.ts",
		"seed": "bun run scripts/seed.ts",
		"seed:prod": "SEED_PROFILE=production bun run scripts/seed.ts",
		"seed:demo": "SEED_PROFILE=demo bun run scripts/seed.ts",
		"db:seed": "npm run seed",
		"db:seed:prod": "bun run seed:prod",
		"db:seed:demo": "bun run seed:demo",
		"db:push:seed": "npm run db:push && npm run seed",
		"db:push:seed:prod": "bun run db:push && bun run seed:prod",
		"db:push:seed:demo": "bun run db:push && bun run seed:demo",
		"db:migrate:seed": "npm run db:migrate && npm run seed",
		"db:migrate:seed:prod": "bun run db:migrate && bun run seed:prod",
		"db:migrate:seed:demo": "bun run db:migrate && bun run seed:demo",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"cf:dev": "bunx wrangler dev --config wrangler.jsonc",
		"cf:dev:pdf": "bunx wrangler dev --config wrangler.pdf.jsonc",
		"cf:deploy": "bunx wrangler deploy --config wrangler.jsonc",
		"cf:deploy:pdf": "bunx wrangler deploy --config wrangler.pdf.jsonc",
		"cf:tail": "bunx wrangler tail --config wrangler.jsonc"
	},
	"dependencies": {
		"@better-auth/expo": "1.5.5",
		"@pdf-lib/fontkit": "^1.1.1",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.10.8",
		"pdf-lib": "^1.17.1",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"shared": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10"
	}
}
