# MM Exam Studio API production template
# Use Wrangler secrets for sensitive values before Cloudflare deploy.
# For Cloudflare Worker deploys, DATABASE_URL should point to a Neon serverless
# Postgres instance. If you keep PostgreSQL elsewhere, keep the API on Bun/Node.

DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

BETTER_AUTH_URL=https://examstudio.hsuwai.space
BETTER_AUTH_SECRET=<generate-strong-secret>
BETTER_AUTH_TRUSTED_ORIGINS=https://examstudio.hsuwai.space,https://adminstudio.hsuwai.space
CORS_ALLOWED_ORIGINS=https://examstudio.hsuwai.space,https://adminstudio.hsuwai.space

ADMIN_EMAILS=admin1@example.com,admin2@example.com
SUPERADMIN_EMAILS=owner@example.com
RESEND_API_KEY=re_<your_resend_api_key>
AUTH_RESET_PASSWORD_FROM_EMAIL=no-reply@hsuwai.space
AUTH_RESET_PASSWORD_FROM_NAME=MM Exam Studio
AUTH_RESET_PASSWORD_LOG_LINK=false

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

REDIS_URL=rediss://default:<password>@<host>:<port>
UPSTASH_REDIS_REST_URL=https://<your-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

SECURITY_HEADERS_ENABLED=true
LOG_FORMAT=json
LOG_LEVEL=info
CORS_ALLOWED_HEADERS=Content-Type, Authorization
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
AUTH_BRUTE_FORCE_WINDOW_MS=600000
AUTH_BRUTE_FORCE_MAX_FAILURES=5
AUTH_BRUTE_FORCE_BLOCK_MS=1800000
API_RATE_LIMIT_PER_MINUTE=300
API_RATE_LIMIT_PER_HOUR=5000
WORKSPACE_CATALOG_RATE_LIMIT_PER_MINUTE=90
WORKSPACE_CATALOG_RATE_LIMIT_PER_HOUR=1800
WORKSPACE_PRACTICE_CREATE_RATE_LIMIT_PER_MINUTE=24
WORKSPACE_PRACTICE_CREATE_RATE_LIMIT_PER_HOUR=300
WORKSPACE_PAPER_CREATE_RATE_LIMIT_PER_MINUTE=12
WORKSPACE_PAPER_CREATE_RATE_LIMIT_PER_HOUR=180
WORKSPACE_PAPER_SWAP_RATE_LIMIT_PER_MINUTE=60
WORKSPACE_PAPER_SWAP_RATE_LIMIT_PER_HOUR=1200
WORKSPACE_PAPER_PDF_RATE_LIMIT_PER_MINUTE=20
WORKSPACE_PAPER_PDF_RATE_LIMIT_PER_HOUR=240
WORKSPACE_DEFAULT_RATE_LIMIT_PER_MINUTE=180
WORKSPACE_DEFAULT_RATE_LIMIT_PER_HOUR=2500
HTTP_SLOW_REQUEST_MS=1200
PDF_RENDERER_TOKEN=<set-same-secret-on-api-and-pdf-worker-or-leave-empty-if-pdf-worker-is-private>

# If you keep the current Node/Bun PDF renderer outside Cloudflare Worker,
# point CHROME_BIN at the installed browser executable there.
CHROME_BIN=
