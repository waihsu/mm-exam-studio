# Monorepo-wide ignore rules

# Dependencies
**/node_modules/
.pnp
.pnp.js

# Build / cache artifacts
**/dist/
**/build/
**/coverage/
**/.cache/
**/.wrangler/
**/.turbo/
**/.vite/
**/.next/
**/.parcel-cache/
**/.expo/
**/.expo-shared/
**/.gradle/
server/.local/
**/*.tsbuildinfo
**/*.apk
**/*.aab
**/*.ipa
tmp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files (keep only examples in git)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Secrets / credentials / signing files
**/*firebase-adminsdk*.json
**/service-account*.json
**/google-services.json
**/google-service.json
**/google-services\ (*.json
**/*.jks
**/*.p12
**/*.p8
**/*.key
**/*.pem
**/*.mobileprovision

# Package manager lockfiles not used in this repo
**/package-lock.json

# Editor / OS
.idea/
**/.idea/
.DS_Store
**/.DS_Store
.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Bun
bun.lockb
